# Development only: set these in the backend process, not frontend VITE_ variables.
# Windows users should configure Odoo through the app (Windows Credential Manager).
ODOO_URL=https://your-company.odoo.com
ODOO_DATABASE=your-company
ODOO_API_KEY=
# Optional absolute path to a Unicode TrueType font:
# LABEL_FONT=C:/Windows/Fonts/arial.ttf
# Optional directory for SQLite queues, calibration records and print history:
# BARCODE_STATE=
